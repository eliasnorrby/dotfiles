{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "VISUAL": "claude_persisted_editor"
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude_notification done"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude_notification input_required"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude_notification reset"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "theme": "auto",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
