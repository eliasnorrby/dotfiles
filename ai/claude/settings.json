{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 3650,
  "env": {
    "VISUAL": "claude_persisted_editor"
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude_notification done"
          },
          {
            "type": "command",
            "command": "wk hook claude stop"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude_notification input_required"
          },
          {
            "type": "command",
            "command": "wk hook claude notification"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude_notification reset"
          },
          {
            "type": "command",
            "command": "claude_session_title hook"
          },
          {
            "type": "command",
            "command": "wiki_checkpoint hook user-prompt-submit"
          },
          {
            "type": "command",
            "command": "wk hook claude user-prompt-submit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "wiki_checkpoint hook pre-tool-use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "wiki_checkpoint hook post-tool-use"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wk hook claude post-tool-use"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wiki_checkpoint hook session-end"
          },
          {
            "type": "command",
            "command": "wk hook claude session-end"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wk hook claude session-start"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wk hook claude permission-request"
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [
      "~/vaults"
    ],
    "allow": [
      "Bash(wiki_checkpoint *)",
      "Bash(wk resolve *)",
      "Bash(wk show *)",
      "Bash(wk config get *)"
    ],
    "deny": [
      "mcp__claude_ai_Gmail__apply_sensitive_message_label",
      "mcp__claude_ai_Gmail__apply_sensitive_thread_label",
      "mcp__claude_ai_Gmail__create_draft",
      "mcp__claude_ai_Gmail__create_label",
      "mcp__claude_ai_Gmail__delete_draft",
      "mcp__claude_ai_Gmail__delete_label",
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Gmail__label_message",
      "mcp__claude_ai_Gmail__label_thread",
      "mcp__claude_ai_Gmail__mark_message_spam",
      "mcp__claude_ai_Gmail__mark_thread_spam",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__trash_message",
      "mcp__claude_ai_Gmail__trash_thread",
      "mcp__claude_ai_Gmail__unlabel_message",
      "mcp__claude_ai_Gmail__unlabel_thread",
      "mcp__claude_ai_Gmail__unmark_message_spam",
      "mcp__claude_ai_Gmail__unmark_thread_spam",
      "mcp__claude_ai_Gmail__untrash_message",
      "mcp__claude_ai_Gmail__untrash_thread",
      "mcp__claude_ai_Gmail__update_draft",
      "mcp__claude_ai_Gmail__update_label",
      "mcp__claude_ai_Gmail__update_message_labels"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true
  },
  "feedbackDrafts": "off",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
