{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 3650,
  "env": {
    "VISUAL": "claude_persisted_editor"
  },
  "permissions": {
    "allow": [
      "Bash(wiki_checkpoint *)",
      "Bash(wk resolve *)",
      "Bash(wk show *)",
      "Bash(wk config get *)"
    ],
    "deny": [
      "Bash(gh pr merge *--admin*)",
      "Bash(gh pr merge *--merge*)",
      "Bash(gh pr merge *--rebase*)",
      "Bash(gh pr merge -m*)",
      "Bash(gh pr merge * -m*)",
      "Bash(gh pr merge -r*)",
      "Bash(gh pr merge * -r*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *mergePullRequest*)",
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__send_message"
    ],
    "additionalDirectories": [
      "~/vaults"
    ]
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude_notification done"
          },
          {
            "type": "command",
            "command": "wk hook claude stop"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude_notification input_required"
          },
          {
            "type": "command",
            "command": "wk hook claude notification"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claude_notification reset"
          },
          {
            "type": "command",
            "command": "claude_session_title hook"
          },
          {
            "type": "command",
            "command": "wiki_checkpoint hook user-prompt-submit"
          },
          {
            "type": "command",
            "command": "wk hook claude user-prompt-submit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "wiki_checkpoint hook pre-tool-use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "wiki_checkpoint hook post-tool-use"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wk hook claude post-tool-use"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wiki_checkpoint hook session-end"
          },
          {
            "type": "command",
            "command": "wk hook claude session-end"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wk hook claude session-start"
          },
          {
            "type": "command",
            "command": "wiki_checkpoint hook session-start"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "wk hook claude permission-request"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true,
    "figma@claude-plugins-official": true
  },
  "feedbackDrafts": "off",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "theme": "custom:system",
  "idleCompaction": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
