{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 10,
  "margin-right": 10,
  "margin-left": 10,
  "margin-bottom": 2,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "custom/pacman"
  ],
  "modules-right": [
    "hyprland/language",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "tray",
    "clock",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "format": "{windows}",
    "on-click": "activate",
    "window-rewrite-default": "•",
    "format-window-separator": "",
    // "window-rewrite-default": "",
    "window-rewrite": {
      "class<TmuxKitty>": " ",
      "class<ChromeWork>": " ",
      "class<ChromePersonal>": " ",
      "class<Slack>": " ",
      "class<spotify>": " ",
      "class<1password>": " ",
      "class<obsidian>": "",
      "class<BtopKitty>": "",
      "class<WhichCmd>": ""
    }
  },
  "hyprland/language": {
    "format": " {}",
    "format-en": "EN",
    "format-se": "SE",
    "on-click": "hyprctl switchxkblayout all next"
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%Y-%m-%d %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 5,
    "on-click": "focus_or_run btop.desktop"
  },
  "memory": {
    "format": " {percentage}%",
    "interval": 5,
    "on-click": "focus_or_run btop.desktop"
  },
  "network": {
    "format": " {bandwidthUpBytes}  {bandwidthUpBytes}",
    // "format-wifi": " {signalStrength}%",
    // "format-ethernet": " {ipaddr}/{cidr}",
    "format-disconnected": "󰖪 ",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "focus_or_run btop.desktop"
  },
  "pulseaudio": {
    "scroll-step": 5, // %, can be a float
    // "format": "{volume}% {icon} {format_source}",
    "format": "{icon} {volume}%",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "tray": {
    "spacing": 10
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
    "menu-actions": {
      "reload": "reload_services",
      "shutdown": "shutdown",
      "reboot": "reboot",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate"
    }
  },
  "custom/pacman": {
    "format": "{}",
    "exec": "check_updates",
    "interval": 1800,
    "tooltip": true,
    "tooltip-format": "System updates available",
    "exec-if": "exit 0",
    "signal": 8
  }
}
