# wk's part of the taskwarrior configuration: the work-item schema and the
# taskwarrior-tui shortcuts that act on it. Included from base/task/taskrc.
#
# The task is the work item; these UDAs are its attributes. Enum-like values
# stay plain lowercase words: '-' and '/' break rc overrides, and a '#' starts
# a comment mid-line (so labels never carry one).

# issue:  tracker key (e.g. TEAM-1234); leads the note filename when set.
uda.issue.type=string
uda.issue.label=Issue
# note:   vault-relative path (no extension) of the task's note. A cache --
#         the durable link is the `task:` uuid in the note's frontmatter.
uda.note.type=string
uda.note.label=Note
# note_flag holds a glyph mirroring "note is set", written by wk. It exists
# only to be shown: taskwarrior-tui ignores the .indicator format, so
# `note.indicator` renders nothing there and a marker needs a real value.
uda.note_flag.type=string
uda.note_flag.label=N
# branch / worktree: where the work happens. worktree is an absolute path and
# is how a session in that directory finds its task.
uda.branch.type=string
uda.branch.label=Branch
uda.worktree.type=string
uda.worktree.label=Worktree
# prs / repo / prstatus: my pull requests fold into the work item they belong
# to. prs lists them in stack order ("#10,#12"); prstatus is the worst status
# across them (failing, changes, review, approved, draft). Per-PR detail lives
# in wk's cache, since UDAs are scalar. No '#' in the label: it would start a
# comment.
uda.prs.type=string
uda.prs.label=PR
uda.repo.type=string
uda.repo.label=Repo
uda.prstatus.type=string
uda.prstatus.label=PRs
uda.prstatus.values=failing,changes,review,approved,draft,
# session: the Claude session that last worked on the task; resume it with
# `claude --resume <id>`.
uda.session.type=string
uda.session.label=Session
# state: what is going on with the task right now, topmost wins. Pushed by
# Claude's and tmux's hooks, written only on change. state_flag mirrors it as
# a glyph for a narrow column (the note_flag trick).
uda.state.type=string
uda.state.label=State
# "checkout" and "resume" rather than "worktree" and "session": a value that
# is also an attribute's name is read as a reference to that attribute.
uda.state.values=input,working,idle,window,checkout,resume,
uda.state_flag.type=string
uda.state_flag.label=S
# partof: uuid of the task this one is a sub-issue of. Not `parent`, which
# taskwarrior's recurrence already owns.
uda.partof.type=string
uda.partof.label=Part of

# == Shortcuts ==
# taskwarrior-tui appends the selected task's uuid to the command, which is
# exactly the locator wk wants. Configuration comes from wk's config file, not
# the environment: the TUI is usually launched from the .desktop entry, which
# never sources a shell.
#
# o: open the task in tmux (its window; else worktree; else branch). Works
# from the tasks popup and from the standalone window alike.
uda.taskwarrior-tui.shortcuts.6=wk open --pause-on-error
uda.taskwarrior-tui.keyconfig.shortcut6=o
# C: every other action valid for the task, in a menu (M is priority). S:
# the whole kickoff.
uda.taskwarrior-tui.shortcuts.7=wk menu --pause-on-error
uda.taskwarrior-tui.keyconfig.shortcut7=C
uda.taskwarrior-tui.shortcuts.8=wk start --pause-on-error
uda.taskwarrior-tui.keyconfig.shortcut8=S
uda.taskwarrior-tui.shortcuts.1=wk open-pr
uda.taskwarrior-tui.keyconfig.shortcut1=P
# Sync runs every minute from a systemd timer; R is "sync now", tracker
# included. The appended uuid is ignored.
uda.taskwarrior-tui.shortcuts.3=wk sync --tracker --wait
uda.taskwarrior-tui.keyconfig.shortcut3=R
# N is taken by taskwarrior-tui's search-previous, so notes open on O.
uda.taskwarrior-tui.shortcuts.4=wk note
uda.taskwarrior-tui.keyconfig.shortcut4=O
# Imports from the clipboard; the appended uuid is not a reference and is
# ignored. A bare PR number resolves against the current repo, so from here
# those need the URL. --wait because the TUI redraws over the output as soon
# as the shortcut exits.
uda.taskwarrior-tui.shortcuts.5=wk import --from clipboard --wait
uda.taskwarrior-tui.keyconfig.shortcut5=I

# == Urgency and colour ==
# PR status moves a work item up or down the list: something to fix or merge
# rises, something merely waiting on others sinks. First-cut values.
# An agent waiting for an answer is the loudest thing on the list.
urgency.uda.state.input.coefficient=8.0
color.uda.state.input=bold white on red
color.uda.state.working=cyan
urgency.uda.prstatus.failing.coefficient=4.0
urgency.uda.prstatus.changes.coefficient=3.0
urgency.uda.prstatus.approved.coefficient=2.0
urgency.uda.prstatus.draft.coefficient=-1.0
urgency.uda.prstatus.review.coefficient=-3.0
color.uda.prstatus.failing=red
color.uda.prstatus.changes=yellow
color.uda.prstatus.approved=green
color.uda.prstatus.review=gray12
