# wk's part of the taskwarrior configuration: the work-item schema and the
# taskwarrior-tui shortcuts that act on it. Included from base/task/taskrc.
#
# The task is the work item; these UDAs are its attributes. Enum-like values
# stay plain lowercase words: '-' and '/' break rc overrides, and a '#' starts
# a comment mid-line (so labels never carry one).

# issue:  tracker key (e.g. TEAM-1234); leads the note filename when set.
uda.issue.type=string
uda.issue.label=Issue
# note:   vault-relative path (no extension) of the task's note. A cache --
#         the durable link is the `task:` uuid in the note's frontmatter.
uda.note.type=string
uda.note.label=Note
# note_flag holds a glyph mirroring "note is set", written by wk. It exists
# only to be shown: taskwarrior-tui ignores the .indicator format, so
# `note.indicator` renders nothing there and a marker needs a real value.
uda.note_flag.type=string
uda.note_flag.label=N
# branch / worktree: where the work happens. worktree is an absolute path (a
# git worktree for issue work, any directory for other work) and is how a
# session in that directory finds its task.
uda.branch.type=string
uda.branch.label=Branch
uda.worktree.type=string
uda.worktree.label=Worktree
# prs / repo: my pull requests fold into the work item they belong to. prs
# lists them in stack order ("#10,#12"). Per-PR detail lives in wk's cache,
# since UDAs are scalar. No '#' in the label: it would start a comment.
uda.prs.type=string
uda.prs.label=PR
uda.repo.type=string
uda.repo.label=Repo
# action / decision / health: what the PR most in need of me means. action is
# the verb (merge, fix, review, assign, finish, await), decision where the PR
# stands (approved, changes, draft), health what is red (failing checks, a
# merge conflict). Whose PR it is decides what red turns into: on mine the
# action is fix; on one I review, the action stays review and the red state
# makes it a worse one to pick up.
uda.action.type=string
uda.action.label=Action
uda.action.values=merge,fix,review,assign,finish,await,
uda.decision.type=string
uda.decision.label=Decision
uda.decision.values=approved,changes,draft,
uda.health.type=string
uda.health.label=Health
uda.health.values=failing,conflict,
# session: the Claude session that last worked on the task; resume it with
# `claude --resume <id>`.
uda.session.type=string
uda.session.label=Session
# state: what is going on with the task right now, topmost wins. Pushed by
# Claude's and tmux's hooks, written only on change. state_flag mirrors it as
# a glyph for a narrow column (the note_flag trick). "checkout" and "resume"
# rather than "worktree" and "session": a value that is also an attribute's
# name is read as a reference to that attribute.
uda.state.type=string
uda.state.label=State
uda.state.values=input,working,idle,window,checkout,resume,
uda.state_flag.type=string
uda.state_flag.label=S
# partof: uuid of the task this one is a sub-issue of. Not `parent`, which
# taskwarrior's recurrence already owns.
uda.partof.type=string
uda.partof.label=Part of

# == Shortcuts ==
# taskwarrior-tui appends the selected task's uuid to the command, which is
# exactly the locator wk wants. Configuration comes from wk's config file, not
# the environment: the TUI is usually launched from the .desktop entry, which
# never sources a shell.
#
# o: open the task in tmux (its window; else worktree; else branch). Works
# from the tasks popup and from the standalone window alike.
uda.taskwarrior-tui.shortcuts.6=wk open --pause-on-error
uda.taskwarrior-tui.keyconfig.shortcut6=o
# C: every other action valid for the task, in a menu (M is priority). S:
# the whole kickoff.
uda.taskwarrior-tui.shortcuts.7=wk menu --pause-on-error
uda.taskwarrior-tui.keyconfig.shortcut7=C
uda.taskwarrior-tui.shortcuts.8=wk start --pause-on-error
uda.taskwarrior-tui.keyconfig.shortcut8=S
uda.taskwarrior-tui.shortcuts.1=wk open-pr
uda.taskwarrior-tui.keyconfig.shortcut1=P
# No "sync now" key: sync runs every minute from a systemd timer and is in
# the C menu, and R belongs to taskwarrior-tui's report switcher.
# N is taken by taskwarrior-tui's search-previous, so notes open on O.
uda.taskwarrior-tui.shortcuts.4=wk note
uda.taskwarrior-tui.keyconfig.shortcut4=O
# Imports from the clipboard; the appended uuid is not a reference and is
# ignored. A bare PR number resolves against the current repo, so from here
# those need the URL. --wait because the TUI redraws over the output as soon
# as the shortcut exits.
uda.taskwarrior-tui.shortcuts.5=wk import --from clipboard --wait
uda.taskwarrior-tui.keyconfig.shortcut5=I

# == Reports ==
# What got done, newest first, with the same attributes as the next report.
# Reach it with the TUI's report switcher (R). The stock `completed` report
# lists oldest first; flipped, for the same reason.
report.recent.description=Recently completed
report.recent.filter=status:completed
report.recent.columns=id,end.age,project,prs,description,issue,note_flag
report.recent.labels=ID,Done,Project,PR,Description,Issue,N
report.recent.sort=end-
report.completed.sort=end-

# == Urgency and colour ==
# What wk knows about a task moves it up the list. Each attribute pulls in one
# direction and the sum sorts: an agent waiting on me first, then PRs by what
# they need of me, shaded by where they stand and what is red, then anything
# with an agent, a window or a checkout. Priority (H 6, M 3.9) stays as it
# is: a plain task marked H lands level with a review to do, below anything
# of mine that needs doing.
urgency.uda.state.input.coefficient=12.0
urgency.uda.state.working.coefficient=4.0
urgency.uda.state.idle.coefficient=4.0
urgency.uda.state.window.coefficient=3.0
urgency.uda.state.checkout.coefficient=2.0
urgency.uda.state.resume.coefficient=1.0
urgency.uda.action.merge.coefficient=10.0
urgency.uda.action.fix.coefficient=7.0
urgency.uda.action.review.coefficient=7.0
urgency.uda.action.assign.coefficient=5.0
urgency.uda.action.finish.coefficient=4.0
urgency.uda.action.await.coefficient=-4.0
urgency.uda.decision.approved.coefficient=3.0
urgency.uda.decision.changes.coefficient=1.0
urgency.uda.decision.draft.coefficient=-2.0
urgency.uda.health.failing.coefficient=-1.0
urgency.uda.health.conflict.coefficient=-2.0
# A task with a note has been thought about.
urgency.uda.note.coefficient=1.0

# Background only for the input state, in the theme's own dark grey (`black`
# is color0, surface1 in catppuccin): the foreground belongs to rules of
# higher precedence (`active` paints a started task green) and stays
# readable on it; the bell glyph in the S column carries the rest of the
# alarm.
color.uda.state.input=on black
color.uda.action.merge=green
color.uda.action.fix=red
color.uda.action.review=yellow
color.uda.action.await=gray12
