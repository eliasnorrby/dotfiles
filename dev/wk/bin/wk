#!/usr/bin/env python3
"""Launcher for wk.

This file is reached through two symlinks (~/.local/bin/wk -> the topic's data
link -> the repo), so the package is located from the resolved path rather than
from sys.path[0].
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from wk.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
