[user]
  email = elias.norrby@gmail.com
  name = Elias Norrby
[core]
  pager = delta -s
[interactive]
  diffFilter = delta --color-only
[diff]
  colorMoved = default
[merge]
  conflictstyle = diff3
[delta]
  navigate = true
[push]
  default = current
[pull]
  rebase = true
[init]
	defaultBranch = main

[tig "color"] cursor = black green bold
[tig "color"] cursor-blur = black green
[tig "color"] title-focus = black blue bold
[tig "color"] title-blur = black blue
[tig "color"] delimiter = black magenta
[tig "color"] date = green default
[tig "color"] author = blue default

[hub]
  protocol = https
[github]
  user = eliasnorrby
[filter "lfs"]
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f

[include]
  path = aliases

[includeIf "gitdir:work/bemlo/"]
  path = config-bemlo

[includeIf "gitdir:~/notes/"]
  path = config-notes

