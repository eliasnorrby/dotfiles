                "rules": [
                    {
                        "description": "Remap caps lock to esc / ctrl",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["left_shift"] }
                                },
                                "to_if_alone": [{ "key_code": "escape" }],
                                "to_if_held_down": [{ "key_code": "left_control" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Remap right control to right option",
                        "manipulators": [
                            {
                                "from": { "key_code": "right_control" },
                                "parameters": { "basic.to_if_held_down_threshold_milliseconds": 10 },
                                "to_if_held_down": [{ "key_code": "right_option" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Trigger App Mode with right cmd",
                        "manipulators": [
                            {
                                "from": { "key_code": "right_command" },
