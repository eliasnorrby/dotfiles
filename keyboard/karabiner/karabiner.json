                                "to_if_held_down": [{ "key_code": "f16" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Set fn as a pseudo hyper key for amethyst",
                        "manipulators": [
                            {
                                "from": { "key_code": "fn" },
                                "to_if_held_down": [
                                    {
                                        "key_code": "left_shift",
