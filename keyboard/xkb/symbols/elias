// macOS-style dashes: keyd translates Option(-position)+hyphen into F13
// (see keyboard/keyd/default.conf). This maps F13 to endash and, with
// Shift, emdash — matching Option+hyphen / Option+Shift+hyphen on macOS.
//
// Shipped as an option (elias:dashes) rather than inside a layout: the
// keymap assembles as pc+<layout>+inet(evdev)+<options>, and inet(evdev)
// claims <FK13> for XF86Tools, so only a section merged after it wins.
partial
xkb_symbols "dashes" {
    key <FK13> { [ endash, emdash ] };
};

// Absolute layout selection: F14..F17 lock xkb group 1..4 (the position in
// kb_layout). Unlike the grp:* toggles this can't drift by one between the
// compositor and espanso, which keeps its own xkb state per input device
// and needs the same option in its config. switch_layout presses these keys
// through ydotool; nothing else should emit them.
partial modifier_keys
xkb_symbols "groups" {
    key <FK14> { [ ISO_First_Group ], actions = [ LockGroup(group=1) ] };
    key <FK15> { [ ISO_Last_Group ],  actions = [ LockGroup(group=2) ] };
    key <FK16> { [ ISO_Group_Shift ], actions = [ LockGroup(group=3) ] };
    key <FK17> { [ ISO_Group_Shift ], actions = [ LockGroup(group=4) ] };
};
