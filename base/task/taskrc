# vim:commentstring=#%s
# Files
data.location=~/.task

# Using this theme means taskwarrior will automatically adapt my terminal color theme.
include dark-16.theme

search.case.sensitive=no

default.project=inbox
verbose=blank,header,footnote,label,new-id,affected,edit,special,sync,unwait,override,recur #project removed
weekstart=monday

alias.@=context
alias.standup=end.after:yesterday project:work completed
alias.standup-sow=end.after:eoww-8d project:work completed

uda.priority.values=H,M,,L
urgency.uda.priority.L.coefficient=-0.5

context.work.read=project:work
context.work.write=project:work

context.dotfiles.read=pro:dotfiles
context.dotfiles.write=pro:dotfiles

report.next.filter=(status:pending or status:waiting) page:limit

# custom started report
report.started.columns=description
report.started.labels=Description
report.started.sort=urgency-
report.started.filter=+ACTIVE

# taskwarrior-tui
uda.taskwarrior-tui.task-report.show-info=false
uda.taskwarrior-tui.task-report.auto-insert-double-quotes-on-add=false

# GitHub PR sync UDAs
uda.pr_number.type=numeric
uda.pr_number.label=PR#
uda.pr_repo.type=string
uda.pr_repo.label=Repo

# == Shortcuts ==
# Taskwarrior-tui shortcut to open PR in browser
uda.taskwarrior-tui.shortcuts.1=task_open_pr
uda.taskwarrior-tui.keyconfig.shortcut1=P
uda.taskwarrior-tui.shortcuts.2=add_wait_tag
uda.taskwarrior-tui.keyconfig.shortcut2=W
uda.taskwarrior-tui.shortcuts.3=gh_pr_task_sync --repo bemlo/bemlo --username eliasnorrby --wait
uda.taskwarrior-tui.keyconfig.shortcut3=R


uda.taskwarrior-tui.background_process=gh_pr_task_sync --repo bemlo/bemlo --username eliasnorrby
uda.taskwarrior-tui.background_process_period=60

# === Styles ===
color.blocked=red
color.blocking=yellow
color.scheduled=green
color.due=magenta
color.tag.wait=yellow
color.active=green

uda.taskwarrior-tui.style.report.selection=black on green
