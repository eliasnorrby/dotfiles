# vim:commentstring=#%s
#
# This file is the shared, version-controlled config, linked to
# ~/.config/task/taskrc. It is *not* the rc file taskwarrior loads first:
# ~/.taskrc is, and it does nothing but `include` this one. Settings that
# taskwarrior rewrites at runtime -- `context=`, anything set through
# `task config` -- are written to whichever rc file is loaded first, so
# they land in ~/.taskrc and stay out of the repo. Never add `context=`
# here; it would be machine-local state in a shared file.

# Files
data.location=~/.task

# Using this theme means taskwarrior will automatically adapt my terminal color theme.
include dark-16.theme

search.case.sensitive=no

default.project=inbox
verbose=blank,header,footnote,label,new-id,affected,edit,special,sync,unwait,override,recur #project removed
weekstart=monday

alias.@=context
alias.standup=end.after:yesterday project:work completed
alias.standup-sow=end.after:eoww-8d project:work completed

uda.priority.values=H,M,,L
urgency.uda.priority.L.coefficient=-0.5

# taskwarrior-tui (0.27.0) skips the first two lines of `task context`
# output, expecting taskwarrior 2.x's two-line piped header. Taskwarrior 3.x
# emits a one-line ANSI-underlined header even when piped, so the
# alphabetically first context is swallowed by the picker. This dummy sorts
# first (digits before letters) and exists only to be eaten. Never activate
# it; remove once the parser is fixed upstream.
context.0filler.read=project:none
context.0filler.write=project:none

context.work.read=project:work
context.work.write=project:work

context.dotfiles.read=pro:dotfiles
context.dotfiles.write=pro:dotfiles

report.next.filter=(status:pending or status:waiting) page:limit

# Surface the tracker key and the PRs with their status. Taskwarrior drops a column
# entirely, header included, when nothing in view fills it, so these two cost
# nothing on a list that has no issues or PRs.
#
# The rest of the list is the stock `next` set reproduced verbatim: there is no
# append-to-default syntax, so naming the columns at all means pinning them and
# no longer picking up changes to the default on upgrade.
report.next.columns=id,start.age,entry.age,depends,priority,project,tags,recur,scheduled.countdown,due.relative,until.remaining,prs,prstatus,description,issue,note_flag,urgency
# No '#' in the labels: taskwarrior treats it as a mid-line comment, which
# silently truncates the rest of the value.
report.next.labels=ID,Active,Age,Deps,P,Project,Tag,Recur,S,Due,Until,PR,PRs,Description,Issue,N,Urg

# custom started report
report.started.columns=description
report.started.labels=Description
report.started.sort=urgency-
report.started.filter=+ACTIVE

# taskwarrior-tui
uda.taskwarrior-tui.task-report.show-info=false
uda.taskwarrior-tui.task-report.auto-insert-double-quotes-on-add=false

# The work-item schema (issue, note, branch, …) and the shortcuts acting on
# it belong to wk.
include ~/.config/wk/taskrc

# == Shortcuts ==
# Shortcuts 1 (P), 3 (R), 4 (O) and 5 (I) are wk's; see its taskrc.
uda.taskwarrior-tui.shortcuts.2=add_wait_tag
uda.taskwarrior-tui.keyconfig.shortcut2=W

# === Styles ===
color.blocked=red
color.blocking=yellow
color.scheduled=green
color.due=magenta
color.tag.wait=yellow
color.active=green

uda.taskwarrior-tui.style.report.selection=black on green
